// Copy to ~/.config/opencode/opencode-multi-agent-team.json (or <project>/.opencode/).
// Every role needs a model. List a backup from a different provider after the main model.
// "provider/model#variant" or a separate "variant" both work.
{
  "agents": {
    "polisher": { "model": ["openai/gpt-5-mini", "anthropic/claude-haiku-4-5"] },
    "triage":   { "model": ["openai/gpt-5-mini", "anthropic/claude-haiku-4-5"] },
    "senior":   { "model": ["openai/gpt-5", "anthropic/claude-sonnet-4-5"], "variant": "high" },
    "explorer": { "model": ["openai/gpt-5-mini", "anthropic/claude-haiku-4-5"], "variant": "low" },
    "fixer":    { "model": ["openai/gpt-5-mini", "anthropic/claude-haiku-4-5"] },
    "analyser": { "model": ["openai/gpt-5", "anthropic/claude-sonnet-4-5"] },
    "oracle":   { "model": ["anthropic/claude-opus-4-5", "openai/gpt-5"], "variant": "high" }
  },

  // Skills and MCP servers per role. Graph search MCPs help triage, senior, explorer and oracle.
  "addons": {
    // "triage":   { "mcps": ["codebase-memory"], "skills": ["codebase-memory"] },
    // "fixer":    { "skills": ["my-shell-skill"] }
  },

  // "off": the polisher sends your message as written, without the confirm step.
  "polish": "on",

  // Make the polisher the default agent.
  "defaultAgent": false,

  "limits": {
    "taskAttempts": 40,
    "fixerRounds": 2,
    "planFailures": 2,
    "oracleAdvice": 1,
    "needInfoPerTask": 6,
    "questionsPerTask": 4,
    "toolCalls": { "triage": 40, "senior": 25, "explorer": 30, "fixer": 150, "analyser": 30, "oracle": 20 },
    "callMinutes": { "default": 30, "fixer": 240 },
    "stallMinutes": 15
  },

  // Review runs after a failure, for risky plans, or when at least this many files changed.
  "review": { "minFiles": 4 },

  // Build commands: long timeout, and their output goes to the task's logs/ folder.
  "buildCommands": { "patterns": ["make *", "ninja *", "cmake *"], "timeoutMin": 120 },

  // Extra shell patterns that always ask you first (added to the built-in list).
  "askCommands": [],

  "taskDir": "~/.cache/opencode-multi-agent-team",

  // Extra prompt text per role, appended from a file.
  "promptAppend": {}
}
