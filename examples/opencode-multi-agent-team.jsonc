// Copy to ~/.config/opencode/opencode-multi-agent-team.json (or <project>/.opencode/).
// Every role needs a model. List a backup from a different provider after the main model.
// "provider/model#variant" or a separate "variant" both work.
//
// Optional per agent (see README "Per-agent tools and instructions"):
//   "skills": [...]        skills the agent loads first
//   "mcps": [...]          MCP servers (through Code Mode), e.g. a code graph
//   "tools": [...]         tools from other plugins, e.g. "docs_search"
//   "commands": [...]      extra shell commands, e.g. "graphify *", "clangd-query *"
//   "instructions": "..."  replaces prompts/<role>.instructions.md (text or file path)
//   "append": "..."        added at the end of the prompt (text or file path)
// Code-search tools help lead, intern and reviewer most. Architect and principal have no tool
// access (only skills): they ask Lead, so tools configured for them are ignored.
{
  "agents": {
    "manager": { "model": ["openai/gpt-5-mini", "anthropic/claude-haiku-4-5"] },
    "lead":   { "model": ["openai/gpt-5-mini", "anthropic/claude-haiku-4-5"] },
    "architect":   { "model": ["openai/gpt-5", "anthropic/claude-sonnet-4-5"], "variant": "high" },
    "intern": {
      "model": ["openai/gpt-5-mini", "anthropic/claude-haiku-4-5"], "variant": "low"
      // , "mcps": ["codebase-memory"], "skills": ["codebase-memory"], "commands": ["graphify *"]
    },
    "developer":    { "model": ["openai/gpt-5-mini", "anthropic/claude-haiku-4-5"] },
    "reviewer": { "model": ["openai/gpt-5", "anthropic/claude-sonnet-4-5"] },
    "principal":   { "model": ["anthropic/claude-opus-4-5", "openai/gpt-5"], "variant": "high" }
  },

  // "manager" sets the model of the three front agents (build-manager, plan-manager,
  // research-manager). Each can have its own polishing instructions, e.g.
  //   "plan-manager": { "instructions": "~/team-prompts/plan-manager.md" }

  // "off": the front agents send your message as written, without the confirm step.
  "polish": "on",

  // Start new sessions in build-manager.
  "defaultAgent": false,

  // Plan and research documents. output: relative to the project ({task} = task name).
  // instructions: replaces the built-in document standard (text or file), e.g. "make plans
  // verbose; always weigh alternatives". The Architect writes to it; Principal reviews against it.
  "workflows": {
    // Plan and non-trivial code tasks: what-document first (instructions), then the change plan (howInstructions).
    "code": { "confirmBrief": false },                       // show Lead's concept brief before the what-document
    "plan": { "output": "docs/{task}.md", "instructions": "", "howInstructions": "", "confirmBrief": true },
    "research": {
      "output": "docs/{task}.md", "instructions": "",
      "confirmBrief": true,                                  // show the research brief first (not for quick research)
      "internRounds": { "quick": 1, "breadth": 2, "depth": 3 }
    }
  },

  "limits": {
    "taskAttempts": 40,
    "developerRounds": 2,
    "planFailures": 2,
    "principalAdvice": 1,
    "principalReviews": 2,   // reviews of a plan or document you can ask Principal for, per task
    "needInfoPerTask": 6,
    "questionsPerTask": 4,
    "toolCalls": { "lead": 40, "architect": 25, "intern": 30, "developer": 150, "reviewer": 30, "principal": 20 },
    "callMinutes": { "default": 30, "developer": 240 },
    "stallMinutes": 15
  },

  // Review runs after a failure, for risky plans, or when at least this many files changed.
  "review": { "minFiles": 4 },

  // The project's build and test commands, exactly as you'd type them. Best set per project in
  // <project>/.opencode/opencode-multi-agent-team.json. Agents use only these and never work out
  // how to build. With both empty, whenMissing decides: "ask" (each task asks: skip, give
  // commands, or stop) or "skip" (no build or test; the result says so).
  "checks": {
    "build": "",   // e.g. "make -j8 app" or "ssh buildhost \"cd /work && make -j16\""
    "test": "",    // e.g. "make test"
    "whenMissing": "ask"
  },

  // More build patterns: long timeout, and their output goes to the task's logs/ folder.
  // The checks commands count as builds automatically.
  "buildCommands": { "patterns": ["make *", "ninja *", "cmake *"], "timeoutMin": 120 },

  // Extra shell patterns that always ask you first (added to the built-in list).
  "askCommands": [],

  "taskDir": "~/.cache/opencode-multi-agent-team"
}
