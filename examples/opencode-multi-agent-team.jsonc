// Copy to ~/.config/opencode/opencode-multi-agent-team.json (or <project>/.opencode/).
// Models: name the models of each tier once. Each role uses its default tier:
//   cheap: manager, intern, operator   normal: analyst, planner, developer
//   good: reviewer                     expensive: architect
// agents.<role>.tier picks another tier; agents.<role>.model always wins (its "variant" wins
// over the tier's). List a backup from a different provider after the main model.
// "provider/model#variant" or a separate "variant" both work.
//
// Optional per agent (see README "Per-agent tools and instructions"):
//   "skills": [...]        skills the agent loads first
//   "mcps": [...]          MCP servers (through Code Mode), e.g. a code graph
//   "tools": [...]         tools from other plugins, e.g. "docs_search"
//   "commands": [...]      extra shell commands, e.g. "graphify *", "clangd-query *"
//   "instructions": "..."  replaces prompts/<role>.instructions.md (text or file path)
//   "append": "..."        added at the end of the prompt (text or file path)
// Code-search tools help analyst, intern and reviewer most. Planner and architect have no tool
// access (only skills): they ask Analyst, so tools configured for them are ignored.
{
  "tiers": {
    "cheap": { "model": ["openai/gpt-5-mini", "anthropic/claude-haiku-4-5"], "variant": "low" },
    "normal": { "model": ["openai/gpt-5-mini", "anthropic/claude-haiku-4-5"] },
    "good": { "model": ["openai/gpt-5", "anthropic/claude-sonnet-4-5"] },
    "expensive": { "model": ["anthropic/claude-opus-4-5", "openai/gpt-5"], "variant": "high" }
  },
  "agents": {
    "planner": { "tier": "good" },
    "intern": {
      // "mcps": ["codebase-memory"], "skills": ["codebase-memory"], "commands": ["graphify *"]
    }
    // A role's own model wins over its tier:
    // , "developer": { "model": ["openai/gpt-5", "anthropic/claude-sonnet-4-5"], "variant": "medium" }
  },

  // "manager" sets the model of the three front agents (build-manager, plan-manager,
  // research-manager). Each can have its own polishing instructions, e.g.
  //   "plan-manager": { "instructions": "~/team-prompts/plan-manager.md" }

  // "off": the front agents send your message as written, without the confirm step.
  "polish": "on",
  // Mode for new tasks: "off" (confirm everything), "polished" (send polished replies without
  // confirming), "safe" (also let the team decide questions and approvals; stops at destructive
  // plans and before implementing), "full" (also those). The user can switch per request.
  "auto": "off",
  // How you review briefs, documents and plans: "ask" (at every stop), "all" (at once) or
  // "sections" (one section at a time, with the recommended option per section).
  "reviewStyle": "ask",

  // Start new sessions in build-manager.
  "defaultAgent": false,

  // Analyst and Developer may have the Operator run something mid-task (web search, API call, script output).
  "operatorCalls": true,

  // Plan and research documents. output: relative to the project ({task} = task name).
  // instructions: replaces the built-in document standard (text or file), e.g. "make plans
  // verbose; always weigh alternatives". The Planner writes to it; Architect reviews against it.
  "workflows": {
    // Plan and non-trivial code tasks: what-document first (instructions), then the change plan (howInstructions).
    "code": { "confirmBrief": false },                       // show Analyst's concept brief before the what-document
    "plan": { "output": "docs/{task}.md", "instructions": "", "howInstructions": "", "confirmBrief": true },
    "research": {
      "output": "docs/{task}.md", "instructions": "",
      "confirmBrief": true,                                  // show the research brief first (not for quick research)
      "internRounds": { "quick": 1, "breadth": 2, "depth": 3 }
    }
  },

  "limits": {
    "taskAttempts": 10,      // failed tries per task (failed step, work sent back, agent call broke); info requests and your comments don't count
    "taskAgentCalls": 100,   // all agent calls per task: a runaway guard
    "developerRounds": 2,
    "planFailures": 2,
    "architectAdvice": 1,
    "architectReviews": 2,   // reviews of a plan or document you can ask Architect for, per task
    "escalateAfterComments": [3, 5],   // your comment rounds on one draft after which the next adviser up advises the writer
    "needInfoPerTask": 6,
    "analystSearchRounds": 3,   // rounds of search queries Analyst may hand to the Intern before each report
    "questionsPerTask": 4,
    "consultsPerStep": 2,     // questions Developer may ask the Planner mid-step (not failed attempts)
    "consultsPerBrief": 3,    // questions Analyst may ask the Planner while writing one brief
    "consultsPerSession": 6,  // questions one pair session with the Planner takes before a fresh one starts
    "runsPerTask": 6,         // Operator runs Analyst and Developer may ask for per task (not failed attempts)
    "toolCalls": { "analyst": 15, "planner": 25, "intern": 100, "developer": 150, "reviewer": 30, "architect": 20, "operator": 30 },
    "callMinutes": { "default": 30, "developer": 240 },
    "stallMinutes": 15
  },

  // Review runs after a failure, for risky plans, or when at least this many files changed.
  "review": { "minFiles": 4 },

  // The project's build and test commands, exactly as you'd type them. Best set per project in
  // <project>/.opencode/opencode-multi-agent-team.json. Agents use only these and never work out
  // how to build. With both empty, whenMissing decides: "ask" (each task asks: skip, give
  // commands, or stop) or "skip" (no build or test; the result says so).
  "checks": {
    "build": "",   // e.g. "make -j8 app" or "ssh buildhost \"cd /work && make -j16\""
    "test": "",    // e.g. "make test"
    "whenMissing": "ask"
  },

  // More build patterns: long timeout, and their output goes to the task's logs/ folder.
  // The checks commands count as builds automatically.
  "buildCommands": { "patterns": ["make *", "ninja *", "cmake *"], "timeoutMin": 120 },

  // Extra shell patterns that always ask you first (added to the built-in list).
  "askCommands": [],

  "taskDir": "~/.cache/opencode-multi-agent-team"
}
